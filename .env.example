# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LLM provider (OpenAI-compatible). Used for embeddings + generation.
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
# Comma-separated fallback chain, tried in order. Prefer several full models
# from different generations over a few small ones: a 503 means that model is
# busy, and on a free tier the smallest models are the most contended.
# `node --env-file=.env.local scripts/list-models.mjs` prints what the key can
# reach and suggests a line. gemini-flash-latest is an alias, so it survives a
# model being retired.
GENERATION_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-flash-latest

# Retrieval tuning
# dense | hybrid. hybrid needs supabase/hybrid.sql to have been run.
RETRIEVAL_MODE=dense
RETRIEVAL_TOP_K=8
MIN_SIMILARITY=0.35

# Development only. Set this if your machine's DNS resolver is broken and you
# cannot fix the network adapter — for example a dead resolver left behind on
# a virtual adapter. Unset in production.
# DEV_DNS_SERVERS=1.1.1.1,8.8.8.8
